# ============================================================
# Neo4j Graph Database
# ============================================================
NEO4J_URL="bolt://localhost:7687"       # bare-metal; use bolt://graphDB:7687 in Docker
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"

# ============================================================
# Ollama
# ============================================================
OLLAMA_BASE_URL="http://localhost:11434"  # bare-metal; use http://localAI:11434 in Docker

# ============================================================
# Worker concurrency (parallel embedding threads)
# ============================================================
MAX_EMBED_WORKERS=4

# ============================================================
# Frontend → Backend URL
# ============================================================
BACKEND_URL="http://localhost:8000"   # bare-metal; use http://backend-server:8000 in Docker

# ============================================================
# HuggingFace model cache (Reranker + Nemotron OCR)
# ============================================================
# Set HF_HUB_OFFLINE=1 once models are downloaded (required for air-gap)
HF_HUB_OFFLINE=0
HF_HOME="/home/<your-user>/.cache/huggingface" # app-user is specified in dockerfile

# ============================================================
# Nemotron OCR v2 (optional overrides)
# ============================================================
# NEMOTRON_OCR_LANG=en
# NEMOTRON_OCR_MERGE_LEVEL=paragraph
# NEMOTRON_OCR_MODEL_DIR=    # leave empty to use HF_HOME cache